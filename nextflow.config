params {
    // input / output (2.1.0)
    cellhome = null              // folder of fastq files named after the cell ids
    outdir   = 'sip_results'
    email    = null              // 2.2 e-mail notification

    // reference
    gtf              = null
    transcript_fasta = null      // salmon
    genome_fasta     = null      // star / hisat2
    salmon_index     = null      // prebuilt indexes (optional)
    star_index       = null
    hisat2_index     = null

    // interchangeable parts
    readqc     = 'fastp'         // fastp | fastqc | afterqc
    quant      = 'salmon'        // salmon | star | hisat2
    count      = 'featurecounts' // featurecounts | htseq | stringtie   (star / hisat2 only)
    quant_unit = 'count'         // salmon: count | tpm;  stringtie: tpm | fpkm
    strandness = 'auto'          // auto (RSeQC) | unstranded | forward | reverse
    strand_reads = 200000

    // downstream (2.1.4)
    using_seurat  = false
    using_monocle = false
    using_scater  = false
    min_cells       = 3
    min_features    = 200
    max_mt          = 30
    regress_vars    = 'percent.mt'   // comma-separated metadata columns regressed out in ScaleData
    n_pcs           = 30
    tsne_dims       = 10
    tsne_perplexity = 30
    cluster_dims    = 10
    resolution      = 0.8
    de_min_pct      = 0.25
    heatmap_genes   = 20
}

process {
    // containers are pinned by digest (tag in the comment) so every run uses identical images
    cpus   = 2
    memory = 4.GB
    time   = 2.h
    withLabel: mid  { cpus = 6;  memory = 16.GB; time = 8.h }
    withLabel: high { cpus = 12; memory = 40.GB; time = 12.h }

    withName: FASTP                  { container = 'quay.io/biocontainers/fastp@sha256:7dcc9e128315636a3c471a82617ca7a103e823cc22d65beb28794d06c1920e1d' }   // 1.4.0--h43da1c4_0
    withName: FASTQC                 { container = 'quay.io/biocontainers/fastqc@sha256:edb831dc3579dce16f49c7d8fd664eb74d0cfc0ed54ad4ea19ef409d254be934' }   // 0.13.0--hdfd78af_0
    withName: AFTERQC                { container = 'quay.io/biocontainers/afterqc@sha256:3c0045647a5cba7dadcedfeca0f1bdbe695c5e5c0993fd5d515b5c6c4ba25be0' }   // 0.9.7--py27_2
    withName: MULTIQC                { container = 'quay.io/biocontainers/multiqc@sha256:ceace1ca5329886d92600c225d34a523020c163b1599403e44c8d895d2dfb2a2' }   // 1.35--pyhdfd78af_2
    withName: 'GTF_TABLES|INFER_STRAND' { container = 'quay.io/biocontainers/rseqc@sha256:f4342a7f0d41dbc2bcc6e855657cdd4be14af09d54690d29c7b15803a81f4460' }   // 5.0.5--pyhdfd78af_0
    withName: 'SALMON_.*'            { container = 'quay.io/biocontainers/salmon@sha256:deee6c1353277c3fa9b579a79eff18f1588ad0a9f098c299d583c49d3613be9b' }   // 2.8.0--hfa8f182_0
    withName: 'STAR_.*'              { container = 'quay.io/biocontainers/star@sha256:c43295cdbc28a7be7d88296775a29cc65b30296c996d8242ef90c031c8b9739b' }   // 2.7.11b--h5ca1c30_8
    withName: HISAT2_INDEX           { container = 'quay.io/biocontainers/hisat2@sha256:dd9d15d12d46a3c49e7aa1cbf12cf49b2f80b54483fea1756b3fda4dde67e385' }   // 2.2.3--h8471819_1
    withName: HISAT2_ALIGN           { container = 'quay.io/biocontainers/mulled-v2-a97e90b3b802d1da3d6958e0867610c718cb5eb1@sha256:13d47f4714d839b7fe817638741f33eb5c97b73a93ff947a1f3381bae318f9d7' }   // 2cdf6bf1e92acbeb9b2834b1c58754167173a410-0; hisat2 2.2.1 + samtools 1.16.1
    withName: 'STRINGTIE.*'          { container = 'quay.io/biocontainers/stringtie@sha256:221523fd04f7ffaf76e78617cbb6069e002ee0f16b0068c3033e4bb0869014ee' }   // 3.0.3--h29c0135_0
    withName: FEATURECOUNTS          { container = 'quay.io/biocontainers/subread@sha256:a0f7ea960dd0f55240b330b5c4515388a493e266a7b427d6a59a39164bc14865' }   // 2.1.1--h577a1d6_0
    withName: HTSEQ                  { container = 'quay.io/biocontainers/htseq@sha256:1cd7edf89c7577d8e9a4980f153a3931d35258d31e2d9fec9d1163fcb780ae51' }   // 2.1.2--py312h4a53a30_3
    withName: 'TXIMPORT|MERGE_TABLES' { container = 'quay.io/biocontainers/bioconductor-tximport@sha256:b81a6536a594d5d730a43015a44e28ccdf5047d43e35ac4198bdfe2aa17207c6' }   // 1.38.2--r45hdfd78af_0
    withName: 'SEURAT|REPORT'        { container = 'satijalab/seurat@sha256:048d965487afc2961c450879692281a73e24f6de47360ed2f11b31112ebd844e' }   // 5.5.1
    withName: MONOCLE2               { container = 'quay.io/biocontainers/bioconductor-monocle@sha256:99084811e4ee1683d404dcf708e0984b26cbe53ee43459dab77b2cd6d99ea776' }   // 2.34.0--r44he5774e6_0; 2.38 breaks on dplyr 1.2 (group_by_ defunct)
    withName: SCATER                 { container = 'quay.io/biocontainers/bioconductor-scater@sha256:5884b81d0e781e7b3af9a420bb75614210132484f522b1a986fb7ed28ddd6460' }   // 1.40.2--r45hdfd78af_0
}

profiles {
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        // $HOME is mounted: keep the user's R settings out of the containers
        env.R_ENVIRON_USER = '/dev/null'
        env.R_PROFILE_USER = '/dev/null'
    }
    slurm {
        process.executor = 'slurm'   // 2.2 cluster environment
    }
}

manifest {
    name = 'SIP'
    description = 'Single-cell Interchangeable Pipeline (Chen et al., bioRxiv 10.1101/456772)'
    mainScript = 'main.nf'
}
